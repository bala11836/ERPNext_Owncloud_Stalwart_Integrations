{
  "services": {
    "private-dns": {
      "image": "coredns/coredns@sha256:0a9d8c8ddf34347eb59aad9a8784f0710de88d6d112726d11d271f9bc6daca26",
      "command": [
        "-conf",
        "/etc/coredns/Corefile"
      ],
      "restart": "unless-stopped",
      "ports": [],
      "volumes": [
        "${RUNTIME_ROOT:?Set RUNTIME_ROOT}/mounts/private_dns_private_dns_0:/etc/coredns/Corefile:ro"
      ],
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "mem_limit": "128m",
      "networks": {
        "default": {},
        "workspace": {
          "aliases": [
            "private-dns-private-dns"
          ]
        }
      }
    }
  },
  "networks": {
    "workspace": {
      "external": true,
      "name": "${WORKSPACE_NETWORK:?Create the workspace network}"
    },
    "default": {
      "internal": true
    }
  },
  "volumes": {}
}
