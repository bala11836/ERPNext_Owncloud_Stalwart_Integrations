{
  "services": {
    "web": {
      "image": "nginx@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236",
      "restart": "unless-stopped",
      "read_only": true,
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run",
        "/tmp"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "CHOWN",
        "SETGID",
        "SETUID"
      ],
      "mem_limit": "64m",
      "ports": [],
      "volumes": [
        "${RUNTIME_ROOT:?Set RUNTIME_ROOT}/mounts/website_web_0:/srv/site:ro",
        "${RUNTIME_ROOT:?Set RUNTIME_ROOT}/mounts/website_web_1:/etc/nginx/conf.d/default.conf:ro"
      ],
      "networks": {
        "default": {},
        "workspace": {
          "aliases": [
            "website-web"
          ]
        }
      }
    }
  },
  "networks": {
    "workspace": {
      "external": true,
      "name": "${WORKSPACE_NETWORK:?Create the workspace network}"
    },
    "default": {
      "internal": true
    }
  }
}
