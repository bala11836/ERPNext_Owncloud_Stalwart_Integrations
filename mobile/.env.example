# Copy to mobile/.env (ignored by Git) and fill in your deployment's values.
# None of these is a secret: they are built into every copy of the app. They are kept out of Git
# because they belong to one deployment, not to the module.

# Build identity (read by app.config.ts at build time).
APP_NAME=ERP
APP_SLUG=erp-mobile
APP_SCHEME=erpmobile
APP_ID=com.example.erp

# Built into the app (EXPO_PUBLIC_ values are visible to anyone with the app).
EXPO_PUBLIC_ERP_URL=https://erp.example.com
# ID of the ERPNext "OAuth Client" record for this app; empty disables sign-in.
EXPO_PUBLIC_OAUTH_CLIENT_ID=
