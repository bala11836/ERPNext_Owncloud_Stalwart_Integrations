<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.approvalalert" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
       The full-page approval alert over the locked screen (owner, 24 November 2026). Android 14+: the person
       allows it once in Settings; the app's Settings screen links there.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>

        <!-- Its own task, not in recents, shown over the locked screen. It shows only the kind, count and site. -->
        <activity
            android:name="expo.modules.approvalalert.AlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:turnScreenOn="true" />

        <receiver
            android:name="expo.modules.approvalalert.AlertReceiver"
            android:exported="false" />
    </application>

</manifest>